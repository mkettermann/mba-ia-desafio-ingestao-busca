# Provedor usado para embeddings e LLM: "openai" ou "google".
# Ao trocar de provedor use outra collection: as dimensoes dos vetores mudam.
LLM_PROVIDER=google

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5-nano

# Google Gemini
GOOGLE_API_KEY=
# models/embedding-001 foi descontinuado; o substituto é gemini-embedding-001
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.1-flash-lite

# Banco de dados (PostgreSQL + pgVector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=gemini_collection

# PDF que será ingerido
PDF_PATH=document.pdf

# Quantidade de chunks enviados por requisicao de embeddings
INGEST_BATCH_SIZE=20
